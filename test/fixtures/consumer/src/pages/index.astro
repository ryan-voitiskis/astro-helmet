---
import Helmet, {
	createSeoHead,
	modulepreload,
	preloadFont,
	preloadImage
} from 'astro-helmet'

const layout = createSeoHead({
	title: 'Layout',
	openGraph: {
		image: [
			{
				url: 'https://example.com/stale-layout.jpg',
				alt: 'stale-layout',
				width: 1200
			},
			'https://example.com/stale-layout-2.jpg'
		]
	}
})
const page = createSeoHead({
	title: 'Cost $& USD',
	titleTemplate: '%s | Site',
	description: 'Packed consumer',
	site: 'https://example.com',
	path: '/fixture',
	robots: 'max-image-preview:large',
	noindex: true,
	nofollow: true,
	openGraph: { image: 'https://example.com/page.png' },
	meta: [{ name: 'flag', content: false }]
})
const resources = {
	link: [
		preloadFont('/consumer.woff2', { type: 'font/woff2' }),
		preloadImage({
			imagesrcset: '/hero.jpg 1x, /hero@2x.jpg 2x',
			fetchpriority: 'high'
		}),
		preloadImage('/both.png'),
		preloadImage('/both.png', { crossorigin: '' }),
		modulepreload('/consumer.js'),
		modulepreload('/consumer.css', { as: 'style' })
	],
	style: [{ textContent: 'body { color: green; }\r\n' }],
	script: [{ textContent: 'window.__consumer = "</SCRIPT>";\r\n' }],
	jsonLd: { '@type': 'Thing', name: '<!--<script>' }
}
---

<!doctype html>
<html lang="en">
	<Helmet
		headItems={[layout, page, resources]}
		options={{ csp: true, validate: false }}
	/>
	<body><h1 id="after">Packed consumer</h1></body>
</html>
