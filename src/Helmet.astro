---
import {
	type HeadItems,
	type HelmetOptions,
	prepareHead,
	getCspSource,
	getComponentValidationOptions,
	validateHeadItems
} from './main'

interface Props {
	headItems: HeadItems | HeadItems[]
	options?: HelmetOptions
}

const { headItems, options = {} } = Astro.props as Props
const {
	applyPriority,
	omitHeadTags = false,
	csp: cspEnabled = false,
	baseUrl,
	validate = import.meta.env.DEV
} = options
const head = prepareHead(headItems, applyPriority)
if (validate) {
	const validationOptions = getComponentValidationOptions(
		options,
		Astro.url,
		head.baseHref
	)
	for (const issue of validateHeadItems(headItems, validationOptions)) {
		console.warn(
			`[astro-helmet] ${issue.code}: ${issue.message}${
				issue.path ? ` (${issue.path})` : ''
			}`
		)
	}
}

// Feature detection also supports Astro 5's experimental CSP API. Access stays
// opt-in because newer Astro versions warn when CSP is not configured.
const csp = cspEnabled
	? (
			Astro as unknown as {
				csp?: {
					insertScriptHash(hash: string): void
					insertStyleHash(hash: string): void
					insertScriptResource(resource: string): void
					insertStyleResource(resource: string): void
				}
			}
		).csp
	: undefined
if (csp) {
	try {
		for (const { type, content } of head.inline) {
			const hashBuffer = await crypto.subtle.digest(
				'SHA-256',
				new TextEncoder().encode(content)
			)
			const hash = btoa(String.fromCharCode(...new Uint8Array(hashBuffer)))
			if (type === 'script') csp.insertScriptHash(`sha256-${hash}`)
			else csp.insertStyleHash(`sha256-${hash}`)
		}

		for (const { type, url } of head.resources) {
			const resource = getCspSource(url, {
				documentUrl: Astro.url,
				baseUrl: baseUrl ?? head.baseHref
			})
			if (!resource) continue
			if (type === 'script') csp.insertScriptResource(resource)
			else csp.insertStyleResource(resource)
		}
	} catch (error) {
		// Astro 5 exposes the methods even when experimental.csp is disabled.
		// Only that explicit unavailable-feature error is a no-op; surface real
		// registration failures instead of silently losing policy entries.
		if (!(error instanceof Error && error.name === 'CspNotEnabled')) throw error
	}
}
---

{
	omitHeadTags ? (
		<Fragment set:html={head.html} />
	) : (
		<head>
			<Fragment set:html={head.html} />
		</head>
	)
}
