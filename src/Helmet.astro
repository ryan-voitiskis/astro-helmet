---
import {
	type HeadItems,
	type HelmetOptions,
	prepareHead,
	getCspSource,
	validateHeadItems
} from './main'

interface Props {
	headItems: HeadItems | HeadItems[]
	options?: HelmetOptions
}

const { headItems, options = {} } = Astro.props as Props
const {
	applyPriority,
	omitHeadTags = false,
	csp: cspEnabled = false,
	baseUrl,
	validate = import.meta.env.DEV
} = options
if (validate) {
	const validationOptions = {
		baseUrl,
		documentUrl: Astro.url,
		...(typeof validate === 'object' ? validate : {})
	}
	for (const issue of validateHeadItems(headItems, validationOptions)) {
		console.warn(
			`[astro-helmet] ${issue.code}: ${issue.message}${
				issue.path ? ` (${issue.path})` : ''
			}`
		)
	}
}
const head = prepareHead(headItems, applyPriority)

// Register CSP hashes and resources when the consumer opts in via `options.csp`
// AND is running on Astro 6+ with CSP configured. Reading `Astro.csp` warns in
// production when CSP isn't configured, so the opt-in keeps the component
// silent for users who don't need CSP integration. Cast avoids typecheck
// failures for downstream consumers on Astro 4/5.
// Astro 5 exposes an experimental API that throws if experimental.csp is off.
// Check the public generator version before accessing it to keep the documented
// Astro 4/5 no-op, including when options.csp is explicitly true.
const astroMajor = Number(Astro.generator.match(/^Astro v(\d+)/)?.[1])
const csp =
	cspEnabled && astroMajor >= 6
		? (
				Astro as unknown as {
					csp?: {
						insertScriptHash(hash: string): void
						insertStyleHash(hash: string): void
						insertScriptResource(resource: string): void
						insertStyleResource(resource: string): void
					}
				}
			).csp
		: undefined
if (csp) {
	for (const { type, content } of head.inline) {
		const hashBuffer = await crypto.subtle.digest(
			'SHA-256',
			new TextEncoder().encode(content)
		)
		const hash = btoa(String.fromCharCode(...new Uint8Array(hashBuffer)))
		if (type === 'script') csp.insertScriptHash(`sha256-${hash}`)
		else csp.insertStyleHash(`sha256-${hash}`)
	}

	for (const { type, url } of head.resources) {
		const resource = getCspSource(url, {
			documentUrl: Astro.url,
			baseUrl: head.baseHref ?? baseUrl
		})
		if (!resource) continue
		if (type === 'script') csp.insertScriptResource(resource)
		else csp.insertStyleResource(resource)
	}
}
---

{
	omitHeadTags ? (
		<Fragment set:html={head.html} />
	) : (
		<head>
			<Fragment set:html={head.html} />
		</head>
	)
}
